rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL PRIMITIVES ---
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        ('email_verified' in request.auth.token &&
         request.auth.token.email_verified == true &&
         'email' in request.auth.token &&
         request.auth.token.email == 'abdulquddus7745@gmail.com') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    // --- VALIDATION BLUEPRINTS ---

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'fullName', 'email', 'mobileNumber', 'userType', 'accountStatus', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['uid', 'fullName', 'email', 'mobileNumber', 'userType', 'accountStatus', 'profilePhotoUri', 'preferredTimezone', 'createdAt', 'updatedAt']) &&
             data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
             data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 80 &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 120 &&
             data.mobileNumber is string && data.mobileNumber.size() <= 30 &&
             data.userType in ['CUSTOMER', 'BARBER'] &&
             data.accountStatus in ['ACTIVE', 'SUSPENDED'] &&
             (!('profilePhotoUri' in data) || data.profilePhotoUri == null || (data.profilePhotoUri is string && data.profilePhotoUri.size() <= 500)) &&
             (!('preferredTimezone' in data) || data.preferredTimezone == null || (data.preferredTimezone is string && data.preferredTimezone.size() <= 60)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidFavourite(data) {
      return data.keys().hasAll(['salonId', 'salonName', 'createdAt']) &&
             data.keys().hasOnly(['salonId', 'salonName', 'salonAddress', 'createdAt']) &&
             data.salonId is string && data.salonId.size() >= 1 && data.salonId.size() <= 128 &&
             data.salonName is string && data.salonName.size() >= 1 && data.salonName.size() <= 100 &&
             (!('salonAddress' in data) || data.salonAddress == null || (data.salonAddress is string && data.salonAddress.size() <= 200)) &&
             isValidTimestamp(data.createdAt);
    }

    function isValidSalon(data) {
      return data.keys().hasAll([
               'ownerId', 'salonName', 'ownerName', 'contactNumber', 'address',
               'workingDays', 'openingTimeMinutes', 'closingTimeMinutes',
               'acceptedPaymentMethods', 'allowCustomerCancellation', 'minCancellationHours',
               'holdTimeoutMinutes', 'timezone', 'averageRating', 'reviewCount',
               'isActive', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'ownerId', 'salonName', 'ownerName', 'logoUri', 'coverImageUri',
               'contactNumber', 'whatsappNumber', 'address', 'mapsLocation',
               'workingDays', 'openingTimeMinutes', 'closingTimeMinutes',
               'breakStartMinutes', 'breakEndMinutes', 'description',
               'acceptedPaymentMethods', 'depositPercent',
               'allowCustomerCancellation', 'minCancellationHours',
               'cancellationRequiresApproval', 'cancellationPolicyText',
               'holdTimeoutMinutes', 'timezone', 'averageRating', 'reviewCount',
               'isActive', 'createdAt', 'updatedAt'
             ]) &&
             data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
             data.salonName is string && data.salonName.size() >= 2 && data.salonName.size() <= 100 &&
             data.ownerName is string && data.ownerName.size() >= 1 && data.ownerName.size() <= 80 &&
             (!('logoUri' in data) || data.logoUri == null || (data.logoUri is string && data.logoUri.size() <= 500)) &&
             (!('coverImageUri' in data) || data.coverImageUri == null || (data.coverImageUri is string && data.coverImageUri.size() <= 500)) &&
             data.contactNumber is string && data.contactNumber.size() <= 30 &&
             (!('whatsappNumber' in data) || data.whatsappNumber == null || (data.whatsappNumber is string && data.whatsappNumber.size() <= 30)) &&
             data.address is string && data.address.size() >= 2 && data.address.size() <= 200 &&
             (!('mapsLocation' in data) || data.mapsLocation == null || (data.mapsLocation is string && data.mapsLocation.size() <= 300)) &&
             data.workingDays is list && data.workingDays.size() <= 7 && (data.workingDays.size() == 0 || data.workingDays[0] is string) &&
             data.openingTimeMinutes is int && data.openingTimeMinutes >= 0 && data.openingTimeMinutes < 1440 &&
             data.closingTimeMinutes is int && data.closingTimeMinutes > data.openingTimeMinutes && data.closingTimeMinutes <= 1440 &&
             (!('breakStartMinutes' in data) || (data.breakStartMinutes is int && data.breakStartMinutes >= -1 && data.breakStartMinutes <= 1440)) &&
             (!('breakEndMinutes' in data) || (data.breakEndMinutes is int && data.breakEndMinutes >= -1 && data.breakEndMinutes <= 1440)) &&
             (!('description' in data) || data.description == null || (data.description is string && data.description.size() <= 600)) &&
             data.acceptedPaymentMethods is list && data.acceptedPaymentMethods.size() >= 1 && data.acceptedPaymentMethods.size() <= 4 &&
             (!('depositPercent' in data) || (data.depositPercent is int && data.depositPercent >= 0 && data.depositPercent <= 100)) &&
             data.allowCustomerCancellation is bool &&
             data.minCancellationHours is int && data.minCancellationHours >= 0 && data.minCancellationHours <= 168 &&
             (!('cancellationRequiresApproval' in data) || data.cancellationRequiresApproval is bool) &&
             (!('cancellationPolicyText' in data) || data.cancellationPolicyText == null || (data.cancellationPolicyText is string && data.cancellationPolicyText.size() <= 400)) &&
             data.holdTimeoutMinutes is int && data.holdTimeoutMinutes >= 1 && data.holdTimeoutMinutes <= 60 &&
             data.timezone is string && data.timezone.size() >= 1 && data.timezone.size() <= 60 &&
             data.averageRating is number && data.averageRating >= 0 && data.averageRating <= 5 &&
             data.reviewCount is int && data.reviewCount >= 0 &&
             data.isActive is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidService(data) {
      return data.keys().hasAll(['salonId', 'barberId', 'salonName', 'name', 'category', 'price', 'durationMinutes', 'isAvailable', 'isActive', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['salonId', 'barberId', 'salonName', 'name', 'category', 'description', 'imageUri', 'price', 'discountPrice', 'durationMinutes', 'isAvailable', 'isActive', 'createdAt', 'updatedAt']) &&
             data.salonId is string && isValidId(data.salonId) &&
             data.barberId is string && isValidId(data.barberId) &&
             data.salonName is string && data.salonName.size() >= 1 && data.salonName.size() <= 100 &&
             data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
             data.category in ['MALE', 'FEMALE', 'BOTH'] &&
             (!('description' in data) || data.description == null || (data.description is string && data.description.size() <= 500)) &&
             (!('imageUri' in data) || data.imageUri == null || (data.imageUri is string && data.imageUri.size() <= 500)) &&
             data.price is number && data.price >= 0 && data.price <= 1000000 &&
             (!('discountPrice' in data) || data.discountPrice == null || (data.discountPrice is number && data.discountPrice >= 0 && data.discountPrice <= data.price)) &&
             data.durationMinutes is int && data.durationMinutes >= 5 && data.durationMinutes <= 480 &&
             data.isAvailable is bool &&
             data.isActive is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidSlotLock(data) {
      return data.keys().hasAll(['salonId', 'barberId', 'date', 'startMinutes', 'endMinutes', 'status', 'holderUid', 'expiresAtEpochMs', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['salonId', 'barberId', 'date', 'startMinutes', 'endMinutes', 'status', 'holderUid', 'appointmentId', 'expiresAtEpochMs', 'createdAt', 'updatedAt']) &&
             data.salonId is string && isValidId(data.salonId) &&
             data.barberId is string && isValidId(data.barberId) &&
             data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             data.startMinutes is int && data.startMinutes >= 0 && data.startMinutes < 1440 &&
             data.endMinutes is int && data.endMinutes > data.startMinutes && data.endMinutes <= 1440 &&
             data.status in ['SELECTED', 'BOOKED', 'CANCELLED'] &&
             data.holderUid is string && isValidId(data.holderUid) &&
             (!('appointmentId' in data) || data.appointmentId == null || (data.appointmentId is string && data.appointmentId.size() <= 128)) &&
             data.expiresAtEpochMs is int && data.expiresAtEpochMs >= 0 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidAppointment(data) {
      return data.keys().hasAll([
               'salonId', 'salonName', 'barberId', 'customerId', 'customerName', 'customerPhone',
               'customerEmail', 'customerGender', 'category', 'serviceIds', 'serviceNames',
               'totalPrice', 'totalDurationMinutes', 'date', 'startMinutes', 'endMinutes',
               'status', 'paymentMethod', 'paymentStatus', 'hasReview', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'salonId', 'salonName', 'barberId', 'customerId', 'customerName', 'customerPhone',
               'customerEmail', 'customerGender', 'category', 'serviceIds', 'serviceNames',
               'totalPrice', 'totalDurationMinutes', 'date', 'startMinutes', 'endMinutes',
               'specialInstructions', 'status', 'paymentMethod', 'paymentStatus', 'slotLockId',
               'cancellationReason', 'cancelledByUid', 'cancelledByRole', 'cancelledAtEpochMs',
               'hasReview', 'createdAt', 'updatedAt'
             ]) &&
             data.salonId is string && isValidId(data.salonId) &&
             data.salonName is string && data.salonName.size() >= 1 && data.salonName.size() <= 100 &&
             data.barberId is string && isValidId(data.barberId) &&
             data.customerId is string && isValidId(data.customerId) &&
             data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 80 &&
             data.customerPhone is string && data.customerPhone.size() <= 30 &&
             data.customerEmail is string && data.customerEmail.size() >= 3 && data.customerEmail.size() <= 120 &&
             data.customerGender in ['MALE', 'FEMALE', 'OTHER'] &&
             data.category in ['MALE', 'FEMALE'] &&
             data.serviceIds is list && data.serviceIds.size() >= 1 && data.serviceIds.size() <= 20 && data.serviceIds[0] is string &&
             data.serviceNames is list && data.serviceNames.size() >= 1 && data.serviceNames.size() <= 20 && data.serviceNames[0] is string &&
             data.totalPrice is number && data.totalPrice >= 0 &&
             data.totalDurationMinutes is int && data.totalDurationMinutes >= 5 && data.totalDurationMinutes <= 720 &&
             data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             data.startMinutes is int && data.startMinutes >= 0 && data.startMinutes < 1440 &&
             data.endMinutes is int && data.endMinutes > data.startMinutes && data.endMinutes <= 1440 &&
             (!('specialInstructions' in data) || data.specialInstructions == null || (data.specialInstructions is string && data.specialInstructions.size() <= 400)) &&
             data.status in ['PENDING', 'BOOKED', 'COMPLETED', 'CANCELLED', 'REJECTED'] &&
             data.paymentMethod in ['PAY_AT_SALON', 'CASH', 'ONLINE', 'DEPOSIT'] &&
             data.paymentStatus in ['PENDING', 'PAID', 'REFUNDED'] &&
             (!('slotLockId' in data) || data.slotLockId == null || (data.slotLockId is string && data.slotLockId.size() <= 128)) &&
             (!('cancellationReason' in data) || data.cancellationReason == null || (data.cancellationReason is string && data.cancellationReason.size() <= 300)) &&
             (!('cancelledByUid' in data) || data.cancelledByUid == null || (data.cancelledByUid is string && data.cancelledByUid.size() <= 128)) &&
             (!('cancelledByRole' in data) || data.cancelledByRole == null || data.cancelledByRole in ['CUSTOMER', 'BARBER', 'ADMIN']) &&
             (!('cancelledAtEpochMs' in data) || data.cancelledAtEpochMs == null || (data.cancelledAtEpochMs is int && data.cancelledAtEpochMs >= 0)) &&
             data.hasReview is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidReview(data) {
      return data.keys().hasAll(['salonId', 'barberId', 'appointmentId', 'customerId', 'customerName', 'rating', 'createdAt']) &&
             data.keys().hasOnly(['salonId', 'barberId', 'appointmentId', 'customerId', 'customerName', 'rating', 'comment', 'createdAt']) &&
             data.salonId is string && isValidId(data.salonId) &&
             data.barberId is string && isValidId(data.barberId) &&
             data.appointmentId is string && isValidId(data.appointmentId) &&
             data.customerId is string && isValidId(data.customerId) &&
             data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 80 &&
             data.rating is int && data.rating >= 1 && data.rating <= 5 &&
             (!('comment' in data) || data.comment == null || (data.comment is string && data.comment.size() <= 500)) &&
             isValidTimestamp(data.createdAt);
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['recipientId', 'senderId', 'title', 'message', 'type', 'isRead', 'createdAt']) &&
             data.keys().hasOnly(['recipientId', 'senderId', 'title', 'message', 'type', 'appointmentId', 'isRead', 'createdAt']) &&
             data.recipientId is string && isValidId(data.recipientId) &&
             data.senderId is string && isValidId(data.senderId) &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.message is string && data.message.size() >= 1 && data.message.size() <= 400 &&
             data.type in ['BOOKING_NEW', 'BOOKING_CONFIRMED', 'BOOKING_RESCHEDULED', 'BOOKING_CANCELLED', 'BOOKING_COMPLETED', 'BOOKING_REJECTED', 'REMINDER'] &&
             (!('appointmentId' in data) || data.appointmentId == null || (data.appointmentId is string && data.appointmentId.size() <= 128)) &&
             data.isRead is bool &&
             isValidTimestamp(data.createdAt);
    }

    function isValidAppSettings(data) {
      return data.keys().hasAll(['defaultTimezone', 'defaultHoldMinutes', 'updatedAt']) &&
             data.keys().hasOnly(['defaultTimezone', 'defaultHoldMinutes', 'updatedAt']) &&
             data.defaultTimezone is string && data.defaultTimezone.size() >= 1 && data.defaultTimezone.size() <= 60 &&
             data.defaultHoldMinutes is int && data.defaultHoldMinutes >= 1 && data.defaultHoldMinutes <= 60 &&
             isValidTimestamp(data.updatedAt);
    }

    // --- COLLECTION RULES ---

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().uid == request.auth.uid &&
                       incoming().accountStatus == 'ACTIVE' &&
                       isValidUserProfile(incoming());
      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().uid == existing().uid &&
                       incoming().createdAt == existing().createdAt && (
                         isAdmin() ||
                         (request.auth.uid == userId &&
                          incoming().accountStatus == existing().accountStatus &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'email', 'mobileNumber', 'userType', 'profilePhotoUri', 'preferredTimezone', 'updatedAt']))
                       );
      allow delete: if isAdmin();

      match /favourites/{salonId} {
        allow get: if isSignedIn() && isValidId(salonId) && request.auth.uid == userId;
        allow list: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() && isValidId(salonId) && request.auth.uid == userId &&
                         incoming().salonId == salonId && isValidFavourite(incoming());
        allow update: if isSignedIn() && isValidId(salonId) && request.auth.uid == userId &&
                         incoming().salonId == existing().salonId && incoming().createdAt == existing().createdAt &&
                         isValidFavourite(incoming());
        allow delete: if isSignedIn() && isValidId(salonId) && request.auth.uid == userId;
      }
    }

    match /salons/{salonId} {
      allow get: if isSignedIn() && isValidId(salonId) && (existing().isActive == true || existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.isActive == true || resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
                       isValidId(salonId) &&
                       incoming().ownerId == request.auth.uid &&
                       isValidSalon(incoming());
      allow update: if isSignedIn() &&
                       isValidId(salonId) &&
                       isValidSalon(incoming()) &&
                       incoming().ownerId == existing().ownerId &&
                       incoming().createdAt == existing().createdAt && (
                         isAdmin() ||
                         (existing().ownerId == request.auth.uid &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'salonName', 'ownerName', 'logoUri', 'coverImageUri',
                            'contactNumber', 'whatsappNumber', 'address', 'mapsLocation',
                            'workingDays', 'openingTimeMinutes', 'closingTimeMinutes',
                            'breakStartMinutes', 'breakEndMinutes', 'description',
                            'acceptedPaymentMethods', 'depositPercent',
                            'allowCustomerCancellation', 'minCancellationHours',
                            'cancellationRequiresApproval', 'cancellationPolicyText',
                            'holdTimeoutMinutes', 'timezone', 'isActive', 'updatedAt'
                          ])) ||
                         incoming().diff(existing()).affectedKeys().hasOnly(['averageRating', 'reviewCount', 'updatedAt'])
                       );
      allow delete: if isSignedIn() && isValidId(salonId) && (existing().ownerId == request.auth.uid || isAdmin());
    }

    match /services/{serviceId} {
      allow get: if isSignedIn() && isValidId(serviceId) && (existing().isActive == true || existing().barberId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.isActive == true || resource.data.barberId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
                       isValidId(serviceId) &&
                       incoming().barberId == request.auth.uid &&
                       isValidService(incoming()) &&
                       exists(/databases/$(database)/documents/salons/$(incoming().salonId)) &&
                       get(/databases/$(database)/documents/salons/$(incoming().salonId)).data.ownerId == request.auth.uid;
      allow update: if isSignedIn() &&
                       isValidId(serviceId) &&
                       isValidService(incoming()) &&
                       incoming().barberId == existing().barberId &&
                       incoming().salonId == existing().salonId &&
                       incoming().createdAt == existing().createdAt &&
                       (existing().barberId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && isValidId(serviceId) && (existing().barberId == request.auth.uid || isAdmin());
    }

    match /slot_locks/{lockId} {
      allow get: if isSignedIn() && isValidId(lockId) && existing().status in ['SELECTED', 'BOOKED', 'CANCELLED'];
      allow list: if isSignedIn() && resource.data.status in ['SELECTED', 'BOOKED', 'CANCELLED'];
      allow create: if isSignedIn() &&
                       isValidId(lockId) &&
                       incoming().holderUid == request.auth.uid &&
                       incoming().status in ['SELECTED', 'BOOKED'] &&
                       isValidSlotLock(incoming()) &&
                       exists(/databases/$(database)/documents/salons/$(incoming().salonId));
      allow update: if isSignedIn() &&
                       isValidId(lockId) &&
                       isValidSlotLock(incoming()) &&
                       incoming().salonId == existing().salonId &&
                       incoming().barberId == existing().barberId &&
                       incoming().createdAt == existing().createdAt && (
                         isAdmin() ||
                         existing().barberId == request.auth.uid ||
                         existing().holderUid == request.auth.uid ||
                         (existing().status == 'CANCELLED' &&
                          incoming().holderUid == request.auth.uid &&
                          incoming().status in ['SELECTED', 'BOOKED'])
                       );
      allow delete: if isSignedIn() && isValidId(lockId) && (existing().holderUid == request.auth.uid || existing().barberId == request.auth.uid || isAdmin());
    }

    match /appointments/{appointmentId} {
      allow get: if isSignedIn() && isValidId(appointmentId) && (existing().customerId == request.auth.uid || existing().barberId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.customerId == request.auth.uid || resource.data.barberId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
                       isValidId(appointmentId) &&
                       incoming().customerId == request.auth.uid &&
                       incoming().status in ['PENDING', 'BOOKED'] &&
                       incoming().hasReview == false &&
                       isValidAppointment(incoming()) &&
                       exists(/databases/$(database)/documents/salons/$(incoming().salonId));
      allow update: if isSignedIn() &&
                       isValidId(appointmentId) &&
                       isValidAppointment(incoming()) &&
                       incoming().salonId == existing().salonId &&
                       incoming().barberId == existing().barberId &&
                       incoming().customerId == existing().customerId &&
                       incoming().createdAt == existing().createdAt && (
                         isAdmin() ||
                         (existing().status == 'COMPLETED' &&
                          existing().customerId == request.auth.uid &&
                          existing().hasReview == false &&
                          incoming().hasReview == true &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['hasReview', 'updatedAt'])) ||
                         (!(existing().status in ['COMPLETED', 'CANCELLED', 'REJECTED']) && (
                           (existing().customerId == request.auth.uid && (
                             (incoming().status == 'CANCELLED' &&
                              incoming().cancelledByUid == request.auth.uid &&
                              incoming().cancelledByRole == 'CUSTOMER' &&
                              incoming().diff(existing()).affectedKeys().hasOnly(['status', 'cancellationReason', 'cancelledByUid', 'cancelledByRole', 'cancelledAtEpochMs', 'paymentStatus', 'updatedAt'])) ||
                             (incoming().status == existing().status &&
                              incoming().diff(existing()).affectedKeys().hasOnly(['date', 'startMinutes', 'endMinutes', 'slotLockId', 'specialInstructions', 'updatedAt']))
                           )) ||
                           (existing().barberId == request.auth.uid && (
                             (incoming().status == 'CANCELLED' &&
                              incoming().cancelledByUid == request.auth.uid &&
                              incoming().cancelledByRole == 'BARBER' &&
                              incoming().diff(existing()).affectedKeys().hasOnly(['status', 'cancellationReason', 'cancelledByUid', 'cancelledByRole', 'cancelledAtEpochMs', 'paymentStatus', 'updatedAt'])) ||
                             (incoming().status in ['BOOKED', 'COMPLETED', 'REJECTED'] &&
                              incoming().diff(existing()).affectedKeys().hasOnly(['status', 'paymentStatus', 'date', 'startMinutes', 'endMinutes', 'slotLockId', 'updatedAt']))
                           ))
                         ))
                       );
      allow delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow get: if isSignedIn() && isValidId(reviewId) && existing().rating >= 1;
      allow list: if isSignedIn() && resource.data.rating >= 1;
      allow create: if isSignedIn() &&
                       isValidId(reviewId) &&
                       incoming().customerId == request.auth.uid &&
                       isValidReview(incoming()) &&
                       exists(/databases/$(database)/documents/appointments/$(incoming().appointmentId)) &&
                       get(/databases/$(database)/documents/appointments/$(incoming().appointmentId)).data.customerId == request.auth.uid &&
                       get(/databases/$(database)/documents/appointments/$(incoming().appointmentId)).data.status == 'COMPLETED';
      allow update: if isSignedIn() &&
                       isValidId(reviewId) &&
                       isValidReview(incoming()) &&
                       incoming().customerId == existing().customerId &&
                       incoming().appointmentId == existing().appointmentId &&
                       incoming().salonId == existing().salonId &&
                       incoming().createdAt == existing().createdAt &&
                       (existing().customerId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && isValidId(reviewId) && (existing().customerId == request.auth.uid || isAdmin());
    }

    match /notifications/{notificationId} {
      allow get: if isSignedIn() && isValidId(notificationId) && (existing().recipientId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.recipientId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
                       isValidId(notificationId) &&
                       incoming().senderId == request.auth.uid &&
                       isValidNotification(incoming());
      allow update: if isSignedIn() &&
                       isValidId(notificationId) &&
                       isValidNotification(incoming()) &&
                       incoming().recipientId == existing().recipientId &&
                       incoming().senderId == existing().senderId &&
                       incoming().createdAt == existing().createdAt &&
                       (existing().recipientId == request.auth.uid || isAdmin()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['isRead']);
      allow delete: if isSignedIn() && isValidId(notificationId) && (existing().recipientId == request.auth.uid || isAdmin());
    }

    match /app_settings/{settingId} {
      allow get: if isSignedIn() && isValidId(settingId) && existing().defaultTimezone is string;
      allow list: if isSignedIn() && resource.data.defaultTimezone is string;
      allow create, update: if isAdmin() && isValidId(settingId) && isValidAppSettings(incoming());
      allow delete: if isAdmin();
    }

    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin() && isValidId(adminId);
    }
  }
}
